# Local secrets and environment configuration
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Python environments and generated files
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/**/*.py[cod]
backend/.pytest_cache/
backend/.uv-cache/

# Local tooling and coverage output
backend/.coverage
backend/htmlcov/
backend/.mypy_cache/
backend/.ruff_cache/

# Frontend dependencies and build output (frontend/.gitignore has the full list)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# OS and editor files
.DS_Store
Thumbs.db
.idea/
*.swp

# Local AI-assistant tooling
.claude/
