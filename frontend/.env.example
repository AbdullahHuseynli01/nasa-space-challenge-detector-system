# Copy to .env.local for local development. Values are read when `next dev`
# starts (restart after changing them) and when `next build` runs.

# Target of the same-origin /api/* proxy: the FastAPI root, without /api.
# Used in development, and in production builds without NEXT_PUBLIC_API_URL
# (e.g. Vercel previews). Defaults to a local FastAPI on http://127.0.0.1:8000.
BACKEND_URL=https://nasa-challenge-backend-nil7.onrender.com

# Production: the browser calls this backend directly, so the backend's
# CORS_ORIGINS must include the site. Set it in Vercel's Production environment.
# In development the proxy is always used; this then only serves as a fallback
# proxy target.
# NEXT_PUBLIC_API_URL=https://nasa-challenge-backend-nil7.onrender.com

# Optional: proxy timeout in milliseconds (AI explanations can take a while).
# BACKEND_PROXY_TIMEOUT_MS=130000
